#!/usr/bin/env python3
"""Listen for Claude Code session lifecycle events on this machine.

Derives events by watching moshi-hook's per-session state store -- the files it
already writes on every hook fire. Nothing is installed and no hooks are
registered; this is a pure reader.

  agent-events sessions
  agent-events listen --session all --event Stop
  agent-events listen --session @feature-eng-98 --event Stop --once
  agent-events listen --session '*/hyperscout*' --event PermissionRequest --json

SESSION SELECTORS
  all                 every session
  <uuid-prefix>       session id, 4+ hex chars (e.g. fdb30f6b)
  @<name>             herdr workspace or cwd basename (e.g. @feature-eng-98)
  <glob>              matched against cwd; bare text is wrapped in *...*

EVENTS
  SessionStart        a new session appeared with a live process
  UserPromptSubmit    lastPromptSubmittedAt advanced
  Stop                lastStopTime advanced -- the turn finished, session is idle
  PermissionRequest   pendingPermissionAt advanced -- blocked awaiting approval
  PermissionResolved  permissionResolvedAt advanced
  ToolUse             lastToolName changed
  SessionEnd          the session's process is gone

CAVEATS (inherent to reading a state store rather than an event log)
  * The store is rewritten in place, so two events of the SAME kind landing
    inside one poll interval collapse into one. Different kinds are unaffected.
  * moshi only records the hooks it registers for, so SubagentStop, PreCompact
    and Notification are not observable, and ToolUse is limited to the tools it
    tracks (AskUserQuestion, ExitPlanMode).
  * SessionEnd is inferred from process death, so it lags by up to one interval.
"""
import argparse
import fnmatch
import glob as globmod
import json
import os
import re
import sys
import time

MOSHI = os.path.expanduser("~/Library/Application Support/Moshi/claude-sessions")
HEX = re.compile(r"^[0-9a-f]{4,}$")

# state field -> event emitted when it advances
ADVANCING = [
    ("lastPromptSubmittedAt", "UserPromptSubmit"),
    ("lastStopTime",          "Stop"),
    ("pendingPermissionAt",   "PermissionRequest"),
    ("permissionResolvedAt",  "PermissionResolved"),
    ("sessionEndedAt",        "SessionEnd"),
]
ALL_EVENTS = ["SessionStart", "ToolUse"] + [e for _, e in ADVANCING]


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def read_all(stale_after=1800):
    """session_id -> state dict, for every file in the store."""
    out = {}
    for f in globmod.glob(os.path.join(MOSHI, "*.json")):
        try:
            d = json.load(open(f))
        except Exception:
            continue                      # mid-write: pick it up next tick
        sid = os.path.basename(f)[:-5]
        cwd = d.get("cwd") or ""
        ws = d.get("herdrWorkspace") or ""
        # Sessions with no terminal record no cwd, but always record a transcript
        # path whose project directory is the cwd slugified. Not losslessly
        # reversible (dashes are ambiguous), so it is used for display and
        # matching only, never rebuilt into a real path.
        slug = ""
        tp = d.get("transcriptPath") or ""
        if tp:
            slug = os.path.basename(os.path.dirname(tp)).lstrip("-")
            prefix = "Users-%s-" % os.path.basename(os.path.expanduser("~"))
            if slug.startswith(prefix):
                slug = slug[len(prefix):].lstrip("-")
        d["_sid"] = sid
        d["_slug"] = slug
        d["_name"] = ws or (os.path.basename(cwd) if cwd else (slug or "?"))
        d["_cwd"] = cwd
        d["_mtime"] = os.path.getmtime(f)
        # Sessions with no terminal (background jobs) carry no agentPid, so pid
        # liveness alone would hide them entirely. Fall back to recent activity.
        pid = d.get("agentPid")
        if d.get("sessionEndedAt"):
            d["_alive"] = False
        else:
            d["_alive"] = alive(pid) if pid else (time.time() - d["_mtime"] < stale_after)
        out[sid] = d
    return out


def fmt_age(secs):
    """Compact age of the last recorded state -- see the stale-record note below."""
    for size, unit in ((60, "s"), (60, "m"), (24, "h")):
        if secs < size:
            return "%d%s" % (secs, unit)
        secs //= size
    return "%dd" % secs


def status_of(s):
    p, r = s.get("pendingPermissionAt", 0), s.get("permissionResolvedAt", 0)
    if p and p > (r or 0):
        return "BLOCKED-approval"
    return "working" if s.get("promptSequence", 0) > s.get("completedPromptSequence", 0) else "idle"


def matches(sel, s):
    if sel == "all":
        return True
    if sel.startswith("@"):
        want = sel[1:].lower()
        return want in (s["_name"].lower(), (s.get("herdrWorkspace") or "").lower(),
                        os.path.basename(s["_cwd"]).lower())
    if HEX.match(sel) and not any(c in sel for c in "*?/"):
        return s["_sid"].startswith(sel)
    pat = sel if any(c in sel for c in "*?") else "*" + sel + "*"
    return fnmatch.fnmatch(s["_cwd"], pat) or fnmatch.fnmatch(s.get("_slug", ""), pat)


def emit(ev, s, ts, args):
    if args.event and ev.lower() not in args.event:
        return False
    if not matches(args.session, s):
        return False
    if args.exclude_session and matches(args.exclude_session, s):
        return False
    if args.json:
        print(json.dumps({
            "ts_ms": int(ts * 1000),
            "ts_iso": time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(ts)),
            "event": ev, "session_id": s["_sid"], "session_name": s["_name"],
            "workspace": s.get("herdrWorkspace") or "", "cwd": s["_cwd"],
            "status": status_of(s), "model": s.get("model") or "",
            "pid": s.get("agentPid"),
            "transcript_path": s.get("transcriptPath") or "",
        }, separators=(",", ":"), ensure_ascii=False), flush=True)
    else:
        line = "%s  %-18s %s [%s]  %s" % (
            time.strftime("%H:%M:%S", time.localtime(ts)), ev,
            s["_name"], s["_sid"][:8], s["_cwd"])
        if ev == "ToolUse" and s.get("lastToolName"):
            line += "  tool=" + s["lastToolName"]
        print(line, flush=True)
    return True


def cmd_sessions(args):
    # age is how long ago the state was last written, not how long the session has
    # been up. A live session whose hooks stalled shows a large age with a stale
    # status -- that pairing is the only way to spot it from the output.
    seen, rows, now = set(), [], time.time()
    for sid, s in sorted(read_all().items(), key=lambda kv: kv[1]["_mtime"], reverse=True):
        pid = s.get("agentPid")
        if not s["_alive"] or (pid is not None and pid in seen):
            continue                      # newest file per live pid wins
        if pid is not None:
            seen.add(pid)
        rows.append("%-17s %5s  %-8s %-22s %-10s pid=%-7s %s" % (
            status_of(s), fmt_age(int(now - s["_mtime"])), sid[:8], s["_name"],
            s.get("model") or "", s.get("agentPid"), s["_cwd"]))
    print("\n".join(rows) if rows else "no live sessions found")
    return 0


def cmd_listen(args):
    args.event = {e.strip().lower() for e in args.event.split(",")} if args.event else None
    prev = read_all()

    if args.since is not None:
        cutoff = args.since if args.since > 1e11 else args.since * 1000
        cutoff /= 1000.0
        for s in sorted(prev.values(), key=lambda x: x["_mtime"]):
            for field, ev in ADVANCING:
                t = s.get(field) or 0
                if t >= cutoff and emit(ev, s, t, args) and args.once:
                    return 0
    if args.no_follow:
        return 0

    while True:
        time.sleep(args.interval)
        cur = read_all()
        for sid, s in sorted(cur.items(), key=lambda kv: kv[1]["_mtime"]):
            old = prev.get(sid)
            if old is None:
                if s["_alive"] and emit("SessionStart", s, s.get("sessionStartTime") or time.time(), args) and args.once:
                    return 0
                continue
            if s["_mtime"] == old["_mtime"] and s["_alive"] == old["_alive"]:
                continue
            for field, ev in ADVANCING:
                if (s.get(field) or 0) > (old.get(field) or 0):
                    if emit(ev, s, s.get(field), args) and args.once:
                        return 0
            if s.get("lastToolName") and s.get("lastToolName") != old.get("lastToolName"):
                if emit("ToolUse", s, s["_mtime"], args) and args.once:
                    return 0
            if old["_alive"] and not s["_alive"]:
                if emit("SessionEnd", s, time.time(), args) and args.once:
                    return 0
        for sid, old in prev.items():       # file removed outright
            if sid not in cur and old["_alive"]:
                if emit("SessionEnd", old, time.time(), args) and args.once:
                    return 0
        prev = cur


def main():
    ap = argparse.ArgumentParser(prog="agent-events", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("sessions", help="list live sessions and their status")
    li = sub.add_parser("listen", help="stream matching lifecycle events")
    li.add_argument("--session", default="all", help="selector; see above (default: all)")
    li.add_argument("--event", default=None,
                    help="comma-separated: " + ",".join(ALL_EVENTS) + " (default: all)")
    li.add_argument("--exclude-session", default=None,
                    help="selector to suppress; avoids waking on your own events")
    li.add_argument("--since", type=float, default=None,
                    help="replay events at/after this epoch (s or ms) before following")
    li.add_argument("--once", action="store_true", help="exit after the first match")
    li.add_argument("--no-follow", action="store_true", help="replay only, do not follow")
    li.add_argument("--json", action="store_true", help="emit JSON lines instead of text")
    li.add_argument("--interval", type=float, default=1.0, help="poll seconds (default: 1.0)")
    a = ap.parse_args()
    return cmd_sessions(a) if a.cmd == "sessions" else cmd_listen(a)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
